  heatmap_mat,
  
  scale="row",
  
  # gene可以聚类
  cluster_rows=TRUE,
  
  # 样本不要整体聚类
  cluster_cols=FALSE,
  
  annotation_col=annotation_col_order,
  annotation_colors=annotation_colors,
  
  gaps_col=gap_position,
  
  color=heat_colors,
  
  border_color=NA
)
