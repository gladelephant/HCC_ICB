############################################################
## 18. Heatmap: 全部亚群互作强度
############################################################

pdf(file.path(outdir, "Heatmap_interaction_weight.pdf"), width = 8, height = 7)

netVisual_heatmap(
  cellchat,
  measure = "weight",
  color.heatmap = "Reds",
  cluster.row = TRUE,
  cluster.col = TRUE
)

dev.off()

