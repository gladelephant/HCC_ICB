#免疫治疗数据集合并，metadata清洗
## 01. A+T_scrnaseq_IMBRAVE150#####========================================
scobj1<-readRDS("A+T_scrnaseq_IMBRAVE150.rds")
scobj1$orig.ident<-scobj1$Patient_ID
scobj1$condition <- "pre_treatment"
table(scobj1@meta.data$Response)
scobj1 <- subset(scobj1, Response %in% c("NonResponder", "Responder"))
scobj1$group <- ifelse(
  scobj1$Response == "NonResponder",
  "pre_resistant",
  "pre_sensitive"
)
scobj1@meta.data$Week<-NULL
table(scobj1@meta.data$Tumour_ID,scobj1@meta.data$Patient_ID)
scobj1@meta.data$Tumour_ID<-NULL
scobj1@meta.data$Patient_ID<-NULL
colnames(scobj1@meta.data)
colnames(scobj1@meta.data)[colnames(scobj1@meta.data) == "Response"] <- "response"
colnames(scobj1@meta.data)[colnames(scobj1@meta.data) == "Treatment"] <- "treatment"
scobj1$response[scobj1$response == "NonResponder"] <- "Non_responder"
table(scobj1@meta.data$response)
scobj1@meta.data$dataset <- "IMBRAVE150"
scobj1@meta.data$sample <- scobj1@meta.data$orig.ident
scobj1@meta.data$lesion <- "tumor"
write_rds(scobj1,"./免疫治疗数据集合并/A+T_scrnaseq_IMBRAVE150.rds")
## 02. HCC_JH_Youqiong#####========================================
scobj2<-readRDS("HCC_JH_Youqiong.rds")
table(scobj2@meta.data$orig.ident)
table(scobj2@meta.data$Pat_Tissues)
scobj2@meta.data$orig.ident<-scobj2@meta.data$Pat_Tissues
scobj2@meta.data$sample <-scobj2@meta.data$Pat_Tissues
scobj2$lesion <- ifelse(
  scobj2$Tissues == "N",
  "normal",
  "tumor"
)
table(scobj2$lesion)
scobj2@meta.data$dataset <- "skrx2fz79n"
scobj2$response <- "Non_responder"
scobj2$condition <- "post_treatment"
scobj2$group <- "post_resistant"
scobj2$treatment <- "anti-PD-1"

keep_cols <- c(
  "orig.ident",
  "nCount_RNA",
  "nFeature_RNA",
  "response",
  "treatment",
  "condition",
  "group",
  "dataset",
  "sample",
  "lesion"
)

scobj2@meta.data <- scobj2@meta.data[, keep_cols, drop = FALSE]
write_rds(scobj2,"./免疫治疗数据集合并/HCC_JH_Youqiong.rds")
