#04.###================================================================================
scobj4<-readRDS("F:\\GSE206325_HCC_ICB_Nat_Med.rds")
table(scobj4$patient_ID,scobj4$tissue)
scobj4$sample <- paste(scobj4$patient_ID, scobj4$tissue, sep = "_")
table(scobj4$sample)
scobj4$orig.ident<-scobj4$sample
scobj4$tissue[scobj4$tissue == "Normal"] <- "normal"
scobj4$tissue[scobj4$tissue == "Tumor"] <- "tumor"
colnames(scobj4@meta.data)[colnames(scobj4@meta.data) == "tissue"] <- "lesion"
colnames(scobj4@meta.data)[colnames(scobj4@meta.data) == "Response"] <- "response"
colnames(scobj4@meta.data)[colnames(scobj4@meta.data) == "Drug"] <- "treatment"
colnames(scobj4@meta.data)[colnames(scobj4@meta.data) == "nCount_originalexp"] <- "nCount_RNA"
colnames(scobj4@meta.data)[colnames(scobj4@meta.data) == "nFeature_originalexp"] <- "nFeature_RNA"

scobj4$orig.ident<-scobj1$Patient_ID
scobj4$condition <- "post_treatment"
table(scobj1@meta.data$Response)

scobj4$response[scobj4$response == "Nonresponder"] <- "Non_responder"
scobj4$dataset<-"GSE206325"
table(scobj4$response)
scobj4$group <- ifelse(
  scobj4$response == "Non_responder",
  "post_resistant",
  "post_sensitive"
)
scobj4$treatment<- NULL
colnames(scobj4@meta.data)[colnames(scobj4@meta.data) == "treatment.1"] <- "treatment"


keep_cols <- c(
  "orig.ident",
  "nCount_RNA",
  "nFeature_RNA",
  "response",
  "treatment",
  "condition",
  "group",
  "dataset",
  "sample",
  "lesion"
)
scobj4@meta.data <- scobj4@meta.data[, keep_cols, drop = FALSE]

write_rds(scobj4,"./免疫治疗数据集合并/GSE206325_HCC_ICB_Nat_Med.rds")


scobj1$barcodes <-row.names(scobj1@meta.data)
scobj2$barcodes <-row.names(scobj2@meta.data)
scobj3$barcodes <-row.names(scobj3@meta.data)
scobj4$barcodes <-row.names(scobj4@meta.data)

table(scobj4@meta.data$treatment)

merged_obj <- merge(
  x = scobj1,
  y = list(scobj2, scobj3, scobj4)
)

keep_cells <- rownames(merged_obj@meta.data)[
  !is.na(merged_obj@meta.data$treatment)
]

scobj5 <- subset(
  merged_obj,
  cells = keep_cells
)

colSums(is.na(scobj5@meta.data))

write_rds(scobj5,"D:\\HCC_ICB_atlas.rds")
