##3. 批量读取top_genes文件夹中的CSV============================================================
gene_folder <- "G:\\HCC_靶免治疗\\CTP_V2\\output\\CTP_analysis\\top_genes"

gene_files <- list.files(
  path = gene_folder,
  pattern = "\\.csv$",
  full.names = TRUE
)

length(gene_files)
basename(gene_files)

#4. 读取每个文件的 gene 列，并以文件名作为CTP名称#####################################
gene_sets <- setNames(
  lapply(gene_files, function(file) {
    
    dat <- read.csv(
      file,
      check.names = FALSE,
      stringsAsFactors = FALSE
    )
    
    if (!"gene" %in% colnames(dat)) {
      stop(
        paste0(
          "文件缺少gene列：",
          basename(file)
        )
      )
    }
    
    genes <- as.character(dat$gene)
    genes <- trimws(genes)
    genes <- genes[
      !is.na(genes) &
        genes != ""
    ]
    
    genes <- unique(genes)
    
    # 只保留表达矩阵中存在的基因
    intersect(
      genes,
      rownames(expr)
    )
  }),
  tools::file_path_sans_ext(
    basename(gene_files)
  )
)

# 查看每个CTP最终使用的基因数
gene_set_summary <- data.frame(
  CTP = names(gene_sets),
  n_gene_used = lengths(gene_sets),
  stringsAsFactors = FALSE
)

gene_set_summary

# ============================================================
# 3. 批量ssGSEA
# ============================================================

param <- ssgseaParam(
  exprData = expr,
  geneSets = gene_sets,
  normalize = FALSE
)

ssgsea_matrix <- gsva(
  param,
  verbose = TRUE
)

dim(ssgsea_matrix)

ssgsea_matrix[
  1:min(5, nrow(ssgsea_matrix)),
  1:min(5, ncol(ssgsea_matrix))
]

# ============================================================
# 4. 转换为长格式
# ============================================================
table(metadata$ORR)
table(metadata$Dataset)

ssgsea_long <- as.data.frame(ssgsea_matrix) %>%
  tibble::rownames_to_column("CTP") %>%
  pivot_longer(
    cols = -CTP,
    names_to = "Sample",
    values_to = "Score"
  ) %>%
  mutate(
    Dataset = metadata[
      Sample,
      "Dataset"
    ],
    ORR = metadata[
      Sample,
      "ORR"
    ]
  )

ssgsea_long$ORR <- factor(
  ssgsea_long$ORR,
  levels = c(
    "Responder",
    "Non_responder"
  )
)

core_score <- as.numeric(
  ssgsea_matrix["Core_signature", ]
)

ctp_names <- setdiff(
  rownames(ssgsea_matrix),
  "Core_signature"
)

cor_results <- lapply(
  ctp_names,
  function(ctp){
    
    tmp <- cor.test(
      core_score,
      as.numeric(ssgsea_matrix[ctp, ]),
      method = "spearman"
    )
    
    data.frame(
      CTP = ctp,
      rho = unname(tmp$estimate),
      pvalue = tmp$p.value
    )
  }
)

cor_results <- do.call(
  rbind,
  cor_results
)

cor_results$FDR <- p.adjust(
  cor_results$pvalue,
  method = "BH"
)

cor_results <- cor_results[
  order(-abs(cor_results$rho)),
]

cor_results

