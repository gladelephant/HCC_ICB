meta$ORR_group <- ifelse(
  meta$Response == "PD",
  "Non_responder",
  ifelse(meta$Response == "PR", "Responder", NA)
)
row.names(meta) <- meta$Sample

ssgsea_df <- data.frame(
  Sample = colnames(ssgsea_score),
  Score = score,
  ORR_group = meta[colnames(ssgsea_score), "ORR_group"]
)

res <- wilcox.test(
  Score ~ ORR_group,
  data = ssgsea_df,
  alternative = "less"
)
pvalue <- res$p.value

