#过滤####================================================================================
mat <- cellchat@net$weight

# 只用非零、非NA值计算阈值
vals <- mat[is.finite(mat) & mat > 0]

cutoff <- quantile(vals, 0.25)

mat.filter <- mat
mat.filter[!is.finite(mat.filter)] <- 0
mat.filter[mat.filter < cutoff] <- 0

# 删除全0行、全0列
keep.row <- rowSums(mat.filter) > 0
keep.col <- colSums(mat.filter) > 0

mat.filter <- mat.filter[keep.row, keep.col, drop = FALSE]

cellchat.filter <- cellchat
cellchat.filter@net$weight <- mat.filter
