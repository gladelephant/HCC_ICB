check_expr <- function(x, name){
  cat("==========", name, "==========\n")
  print(summary(as.numeric(x)))
  cat("Min:", min(x, na.rm=TRUE), "\n")
  cat("Max:", max(x, na.rm=TRUE), "\n")
  cat("Mean:", mean(as.numeric(x), na.rm=TRUE), "\n")
  cat("95%:", quantile(as.numeric(x), 0.95, na.rm=TRUE), "\n")
  cat("99%:", quantile(as.numeric(x), 0.99, na.rm=TRUE), "\n\n")
}

