# ============================================================
# 9. 计算各 cluster 平均细胞组成
# ============================================================
library(magrittr)
library(tidyverse)
library(dplyr)
composition_df <- as.data.frame(deconv.mat)

composition_df$CompositionCluster <- sp@meta.data[[composition_key]]

cluster_mean_composition <- composition_df %>%
  group_by(CompositionCluster) %>%
  summarise(
    across(
      where(is.numeric),
      mean,
      na.rm = TRUE
    )
  )

cluster_mean_long <- cluster_mean_composition %>%
  pivot_longer(
    cols = -CompositionCluster,
    names_to = "Celltype",
    values_to = "Mean_proportion"
  )

ggplot(
  cluster_mean_long,
  aes(
    x = Celltype,
    y = CompositionCluster,
    fill = Mean_proportion
  )
) +
  geom_tile() +
  theme_classic() +
  theme(
    axis.text.x = element_text(
      angle = 90,
      hjust = 1
    )
  ) +
  labs(
    x = NULL,
    y = "Composition cluster",
    fill = "Mean\nproportion"
  )
