library(data.table)
cell2location_df <- fread(
  "cell2location_abundance.csv",
  data.table = FALSE
)

dim(cell2location_df)
head(cell2location_df[, 1:5])

rownames(cell2location_df) <- cell2location_df$barcode
cell2location_df$barcode <- NULL
cell2location_df[] <- lapply(
  cell2location_df,
  as.numeric
)

deconv.mat <- as.matrix(cell2location_df)

length(colnames(sp))
nrow(deconv.mat)

sum(colnames(sp) %in% rownames(deconv.mat))
sum(rownames(deconv.mat) %in% colnames(sp))

common_barcodes <- intersect(
  colnames(sp),
  rownames(deconv.mat)
)

length(common_barcodes)

sp <- subset(
  sp,
  cells = common_barcodes
)

deconv.mat <- deconv.mat[
  colnames(sp),
  ,
  drop = FALSE
]

stopifnot(
  identical(
    colnames(sp),
    rownames(deconv.mat)
  )
)

colnames(deconv.mat) <- sub(
  "^abundance_",
  "",
  colnames(deconv.mat)
)

head(colnames(deconv.mat), 20)

##cell2location 输出通常是每个 spot 中各细胞类型的 posterior abundance，而不是总和等于 1 的 probability
summary(rowSums(deconv.mat)) #每行总和明显不是 1，这是正常的

#行归一化成 composition proportion
spot_total <- rowSums(deconv.mat)

spot_total[spot_total == 0] <- 1

deconv.prop <- deconv.mat / spot_total

summary(rowSums(deconv.prop))

deconv.mat <- deconv.prop

deconv.raw <- as.matrix(cell2location_df)

colnames(deconv.raw) <- sub(
  "^abundance_",
  "",
  colnames(deconv.raw)
)

deconv.raw <- deconv.raw[
  colnames(sp),
  ,
  drop = FALSE
]

spot_total <- rowSums(deconv.raw)
spot_total[spot_total == 0] <- 1

deconv.prop <- deconv.raw / spot_total

abundance.metadata <- as.data.frame(deconv.raw)

colnames(abundance.metadata) <- paste0(
  "c2l_abundance_",
  colnames(abundance.metadata)
)

sp <- AddMetaData(
  object = sp,
  metadata = abundance.metadata
)

proportion.metadata <- as.data.frame(deconv.prop)

colnames(proportion.metadata) <- paste0(
  "c2l_prop_",
  colnames(proportion.metadata)
)

sp <- AddMetaData(
  object = sp,
  metadata = proportion.metadata
)

proportion.metadata <- as.data.frame(deconv.prop)

colnames(proportion.metadata) <- paste0(
  "c2l_prop_",
  colnames(proportion.metadata)
)

