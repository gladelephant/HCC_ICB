library(Seurat)
library(data.table)

spatial_dir <- "F:\\HCC_空转\\HCC-2T\\HCC-2T"

sp <- Load10X_Spatial(
  data.dir = spatial_dir,
  filename = "filtered_feature_bc_matrix.h5",
  assay = "Spatial",
  slice = "HCC-2T",
  filter.matrix = TRUE,
  to.upper = FALSE
)

Images(sp)


library(Seurat)
library(Matrix)

# 假设空间对象名称为 sp
DefaultAssay(sp) <- "Spatial"

# ============================================================
# 1. 计算线粒体基因比例
# ============================================================

sp[["pct_counts_mt"]] <- PercentageFeatureSet(
  sp,
  assay = "Spatial",
  pattern = "^MT-"
)

# ============================================================
# 2. 过滤 spot
#    等价于：
#    sc.pp.filter_cells(min_counts = 500)
#    sc.pp.filter_cells(min_genes = 200)
#    pct_counts_mt < 25
# ============================================================

sp <- subset(
  sp,
  subset =
    nCount_Spatial >= 500 &
    nFeature_Spatial >= 200 &
    pct_counts_mt < 25
)

# ============================================================
# 3. 过滤基因
#    等价于：
#    sc.pp.filter_genes(adata, min_cells = 10)
# ============================================================

counts_mat <- GetAssayData(
  sp,
  assay = "Spatial",
  layer = "counts"
)

keep_genes <- rowSums(counts_mat > 0) >= 10

sp <- subset(
  sp,
  features = rownames(counts_mat)[keep_genes]
)

# ============================================================
# 4. 检查过滤后的对象
# ============================================================

sp

summary(sp$nCount_Spatial)
summary(sp$nFeature_Spatial)
summary(sp$pct_counts_mt)

counts_check <- LayerData(
  sp,
  assay = "Spatial",
  layer = "counts"
)

summary(rowSums(counts_check > 0))
min(rowSums(counts_check > 0))

dim(sp)

